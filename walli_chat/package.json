{
  "name": "@walli/chat",
  "version": "0.0.0-beta.0",
  "description": "High-performance, general-purpose AI chat component.",
  "keywords": [
    "web-components",
    "ai-chat",
    "chat-ui",
    "ai-ui",
    "conversation-ui",
    "message-list",
    "chat-input",
    "llm",
    "react",
    "vue",
    "custom-elements",
    "high-performance",
    "virtual-list"
  ],
  "homepage": "https://www.wallibot.dev",
  "bugs": {
    "url": "https://github.com/JinYuSha0/walli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JinYuSha0/walli.git"
  },
  "author": {
    "name": "JinYuSha0",
    "url": "https://github.com/JinYuSha0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/types/vue/index.d.ts",
      "import": "./dist/vue.js"
    },
    "./theme.css": "./dist/walli-chat.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "format": "prettier --write .",
    "build": "vite build && pnpm run build:types",
    "build:demo": "vite build --mode demo",
    "build:types": "tsc -p tsconfig.build.json",
    "deploy:demo": "pnpm run build:demo && pnpm dlx wrangler pages deploy dist-demo --project-name=walli-chat-demo --branch=main --commit-dirty=true",
    "analyze": "vite build --mode analyze && pnpm run build:types",
    "preview": "vite preview",
    "prepublishOnly": "pnpm run build",
    "storybook": "storybook dev -p 6006",
    "storybook:react": "storybook dev -p 6007 -c .storybook-react",
    "storybook:vue": "storybook dev -p 6008 -c .storybook-vue",
    "build-storybook": "storybook build",
    "build-storybook:react": "storybook build -c .storybook-react -o storybook-static-react",
    "build-storybook:vue": "storybook build -c .storybook-vue -o storybook-static-vue",
    "deploy:storybook": "pnpm run build-storybook && pnpm dlx wrangler pages deploy storybook-static --project-name=walli-chat-storybook --branch=main --commit-dirty=true"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@walli/chat-blocks": "workspace:*",
    "@preact/signals-core": "^1.14.4",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@storybook/vue3-vite": "^10.5.10",
    "@storybook/web-components-vite": "^10.5.10",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^10.5.10",
    "typescript": "~6.0.2",
    "unocss": "^66.7.5",
    "vite": "^8.2.0",
    "vue": "^3.5.30"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "clsx": "^2.1.1",
    "lit": "^3.3.3",
    "lucide": "^1.31.0",
    "marked": "^18.0.7",
    "photoswipe": "^5.4.4",
    "prismjs": "^1.30.0",
    "remend": "^1.3.0"
  }
}
