{
  "name": "walli_chat",
  "version": "0.0.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./theme.css": "./dist/walli-chat.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "format": "prettier --write .",
    "build": "vite build && pnpm run build:types",
    "build:demo": "vite build --mode demo",
    "build:types": "tsc -p tsconfig.build.json",
    "deploy:demo": "pnpm run build:demo && pnpm dlx wrangler pages deploy dist-demo --project-name=walli-chat-demo --branch=main --commit-dirty=true",
    "analyze": "vite build --mode analyze && pnpm run build:types",
    "preview": "vite preview",
    "prepublishOnly": "pnpm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy:storybook": "pnpm run build-storybook && pnpm dlx wrangler pages deploy storybook-static --project-name=walli-chat-storybook --branch=main --commit-dirty=true"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@preact/signals-core": "^1.14.4",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/web-components-vite": "^10.5.10",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^10.5.10",
    "typescript": "~6.0.2",
    "unocss": "^66.7.5",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "clsx": "^2.1.1",
    "lit": "^3.3.3",
    "lucide": "^1.31.0",
    "marked": "^18.0.7",
    "photoswipe": "^5.4.4",
    "prismjs": "^1.30.0",
    "remend": "^1.3.0"
  }
}
