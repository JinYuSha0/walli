{
  "name": "walli_bot",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:pre:beta": "changeset pre enter beta",
    "changeset:pre:exit": "changeset pre exit",
    "version-packages": "changeset version",
    "build:packages": "pnpm --filter @wallilabs/chat run build && pnpm --filter @wallilabs/chat-blocks run build",
    "release": "pnpm run build:packages && changeset publish",
    "build:walli_core": "pnpm --filter @wallilabs/core run build",
    "check:walli_core": "pnpm --filter @wallilabs/core run check",
    "deploy:walli_core": "pnpm --filter @wallilabs/core run deploy",
    "dev:walli_core": "pnpm --filter @wallilabs/core run dev",
    "dev:walli_chat": "pnpm --filter @wallilabs/chat run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:walli_core": "pnpm --filter @wallilabs/core run lint",
    "test": "echo \"Error: no test specified\" && exit 1",
    "secrets": "pnpm --filter @wallilabs/core run secrets",
    "db:generate:walli_core": "pnpm --filter @wallilabs/core run db:generate",
    "db:check:walli_core": "pnpm --filter @wallilabs/core run db:check",
    "db:migrate:walli_core:local": "pnpm --filter @wallilabs/core run db:migrate:local",
    "db:migrate:walli_core:remote": "pnpm --filter @wallilabs/core run db:migrate:remote"
  },
