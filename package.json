{
  "name": "walli_bot",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:walli_core": "pnpm --filter @wallilabs/core run build",
    "check:walli_core": "pnpm --filter @wallilabs/core run check",
    "deploy:walli_core": "pnpm --filter @wallilabs/core run deploy",
    "dev:walli_core": "pnpm --filter @wallilabs/core run dev",
    "dev:walli_chat": "pnpm --filter @wallilabs/chat run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:walli_core": "pnpm --filter @wallilabs/core run lint",
    "publish:chat:alpha": "pnpm --dir walli_chat run publish:alpha",
    "publish:chat:beta": "pnpm --dir walli_chat run publish:beta",
    "publish:chat:dry-run": "pnpm --dir walli_chat run publish:dry-run",
    "publish:chat:latest": "pnpm --dir walli_chat run publish:latest",
    "publish:chat-blocks:alpha": "pnpm --dir walli_chat_blocks run publish:alpha",
    "publish:chat-blocks:beta": "pnpm --dir walli_chat_blocks run publish:beta",
    "publish:chat-blocks:dry-run": "pnpm --dir walli_chat_blocks run publish:dry-run",
    "publish:chat-blocks:latest": "pnpm --dir walli_chat_blocks run publish:latest",
    "test": "echo \"Error: no test specified\" && exit 1",
    "secrets": "pnpm --filter @wallilabs/core run secrets",
    "db:generate:walli_core": "pnpm --filter @wallilabs/core run db:generate",
    "db:check:walli_core": "pnpm --filter @wallilabs/core run db:check",
    "db:migrate:walli_core:local": "pnpm --filter @wallilabs/core run db:migrate:local",
    "db:migrate:walli_core:remote": "pnpm --filter @wallilabs/core run db:migrate:remote"
  },
  "keywords": [],
